# Copie para backend.hcl e ajuste. Inicialize com:
#   terraform init -backend-config=backend.hcl
#
# O bucket de state precisa existir previamente (ver README). State em S3, sem lock DynamoDB.

bucket = "SEU-BUCKET-DE-TFSTATE"
key    = "aws-sistemas-distribuidos-ssa/terraform.tfstate"
region = "us-east-1"
encrypt = true
