# ---- Servidor ----
PORT=3000

# ---- Banco de dados (AWS RDS MySQL) ----
DB_HOST=seu-endpoint-rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=sua_senha
DB_NAME=aula_pratica_db
DB_PORT=3306

# ---- AWS / S3 (upload de imagens) ----
# NAO coloque credenciais reais neste arquivo. Use Secrets do GitHub em producao
# ou uma IAM Role anexada a instancia EC2 (recomendado, evita AWS_ACCESS_KEY_ID/SECRET no servidor).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=aula-pratica-imagens-seunome
